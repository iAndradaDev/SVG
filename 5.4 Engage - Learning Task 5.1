<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Learning Task 5.1 - SVG Art</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f4f4f4;
        }

        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
        }

        .art {
            background: white;
            padding: 10px;
            border-radius: 8px;
        }

        svg {
            border: 2px solid #333;
        }

        p {
            font-size: 13px;
            font-weight: bold;
        }
    </style>
</head>
<body>

<h1>Learning Task 5.1</h1>
<h2>SVG Graphic Arts</h2>

<div class="container">

    <!-- 1. Line and Circle -->
    <div class="art">
        <svg width="200" height="300">
            <rect width="200" height="300" fill="#fff5e6"/>

            <line x1="100" y1="300" x2="100" y2="100"
                  stroke="green" stroke-width="8"/>
            <line x1="100" y1="200" x2="40" y2="150"
                  stroke="green" stroke-width="6"/>
            <line x1="100" y1="230" x2="160" y2="180"
                  stroke="green" stroke-width="6"/>

            <circle cx="100" cy="85" r="45" fill="#ff6b6b"/>
            <circle cx="100" cy="85" r="20" fill="#ffdd59"/>

            <circle cx="40" cy="145" r="25" fill="#ff9f43"/>
            <circle cx="40" cy="145" r="10" fill="#fff"/>

            <circle cx="160" cy="175" r="25" fill="#ee5253"/>
            <circle cx="160" cy="175" r="10" fill="#fff"/>
        </svg>
        <p>1. Line and Circle</p>
    </div>

    <!-- 2. Circle and Rectangle -->
    <div class="art">
        <svg width="200" height="300">
            <rect width="200" height="300" fill="#dff9fb"/>

            <rect x="20" y="60" width="160" height="200"
                  fill="#48dbfb"/>
            <rect x="35" y="80" width="130" height="50"
                  fill="#0abde3"/>
            <rect x="35" y="145" width="130" height="50"
                  fill="#0abde3"/>
            <rect x="35" y="210" width="130" height="35"
                  fill="#0abde3"/>

            <circle cx="60" cy="105" r="15" fill="#ff6b6b"/>
            <circle cx="100" cy="105" r="15" fill="#feca57"/>
            <circle cx="140" cy="105" r="15" fill="#ff6b6b"/>

            <circle cx="60" cy="170" r="15" fill="#feca57"/>
            <circle cx="100" cy="170" r="15" fill="#ff6b6b"/>
            <circle cx="140" cy="170" r="15" fill="#feca57"/>

            <circle cx="60" cy="227" r="10" fill="#fff"/>
            <circle cx="100" cy="227" r="10" fill="#fff"/>
            <circle cx="140" cy="227" r="10" fill="#fff"/>
        </svg>
        <p>2. Circle and Rectangle</p>
    </div>

    <!-- 3. Polyline and Circle -->
    <div class="art">
        <svg width="200" height="300">
            <rect width="200" height="300" fill="#fff"/>

            <polyline points="0,50 25,20 50,50 75,20 100,50 125,20 150,50 175,20 200,50"
                      fill="none" stroke="#ff6b6b" stroke-width="12"/>

            <polyline points="0,110 25,80 50,110 75,80 100,110 125,80 150,110 175,80 200,110"
                      fill="none" stroke="#1dd1a1" stroke-width="12"/>

            <polyline points="0,170 25,140 50,170 75,140 100,170 125,140 150,170 175,140 200,170"
                      fill="none" stroke="#54a0ff" stroke-width="12"/>

            <polyline points="0,230 25,200 50,230 75,200 100,230 125,200 150,230 175,200 200,230"
                      fill="none" stroke="#feca57" stroke-width="12"/>

            <circle cx="25" cy="65" r="12" fill="#ff9f43"/>
            <circle cx="75" cy="65" r="12" fill="#ff9f43"/>
            <circle cx="125" cy="65" r="12" fill="#ff9f43"/>
            <circle cx="175" cy="65" r="12" fill="#ff9f43"/>

            <circle cx="25" cy="185" r="12" fill="#ee5253"/>
            <circle cx="75" cy="185" r="12" fill="#ee5253"/>
            <circle cx="125" cy="185" r="12" fill="#ee5253"/>
            <circle cx="175" cy="185" r="12" fill="#ee5253"/>
        </svg>
        <p>3. Polyline and Circle</p>
    </div>

    <!-- 4. Polygon and Ellipse -->
    <div class="art">
        <svg width="200" height="300">
            <rect width="200" height="300" fill="#e8f8f5"/>

            <polygon points="100,20 180,100 100,180 20,100"
                     fill="#00b894"/>
            <polygon points="100,45 155,100 100,155 45,100"
                     fill="#55efc4"/>

            <ellipse cx="100" cy="100" rx="35" ry="50"
                     fill="#fdcb6e"/>
            <ellipse cx="100" cy="100" rx="18" ry="30"
                     fill="#e17055"/>

            <polygon points="100,180 180,270 20,270"
                     fill="#0984e3"/>

            <ellipse cx="100" cy="235" rx="40" ry="20"
                     fill="#74b9ff"/>
            <ellipse cx="100" cy="235" rx="20" ry="10"
                     fill="#fff"/>
        </svg>
        <p>4. Polygon and Ellipse</p>
    </div>

    <!-- 5. Circle, Line and Rectangle -->
    <div class="art">
        <svg width="200" height="300">
            <rect width="200" height="300" fill="#ffeaa7"/>

            <rect x="20" y="30" width="160" height="240"
                  fill="#fab1a0"/>

            <line x1="20" y1="90" x2="180" y2="90"
                  stroke="#d63031" stroke-width="5"/>
            <line x1="20" y1="160" x2="180" y2="160"
                  stroke="#d63031" stroke-width="5"/>
            <line x1="20" y1="230" x2="180" y2="230"
                  stroke="#d63031" stroke-width="5"/>

            <line x1="60" y1="30" x2="60" y2="270"
                  stroke="#fff" stroke-width="4"/>
            <line x1="100" y1="30" x2="100" y2="270"
                  stroke="#fff" stroke-width="4"/>
            <line x1="140" y1="30" x2="140" y2="270"
                  stroke="#fff" stroke-width="4"/>

            <circle cx="40" cy="60" r="12" fill="#00cec9"/>
            <circle cx="80" cy="60" r="12" fill="#00cec9"/>
            <circle cx="120" cy="60" r="12" fill="#00cec9"/>
            <circle cx="160" cy="60" r="12" fill="#00cec9"/>

            <circle cx="40" cy="125" r="12" fill="#6c5ce7"/>
            <circle cx="80" cy="125" r="12" fill="#6c5ce7"/>
            <circle cx="120" cy="125" r="12" fill="#6c5ce7"/>
            <circle cx="160" cy="125" r="12" fill="#6c5ce7"/>

            <circle cx="40" cy="195" r="12" fill="#00b894"/>
            <circle cx="80" cy="195" r="12" fill="#00b894"/>
            <circle cx="120" cy="195" r="12" fill="#00b894"/>
            <circle cx="160" cy="195" r="12" fill="#00b894"/>
        </svg>
        <p>5. Circle, Line and Rectangle</p>
    </div>

    <!-- 6. Polyline and Polygon -->
    <div class="art">
        <svg width="200" height="300">
            <rect width="200" height="300" fill="#2d3436"/>

            <polygon points="100,20 180,150 100,280 20,150"
                     fill="#6c5ce7"/>
            <polygon points="100,50 150,150 100,250 50,150"
                     fill="#a29bfe"/>
            <polygon points="100,90 130,150 100,210 70,150"
                     fill="#fd79a8"/>

            <polyline points="0,30 40,60 0,90 40,120 0,150"
                      fill="none" stroke="#ffeaa7" stroke-width="8"/>

            <polyline points="200,30 160,60 200,90 160,120 200,150"
                      fill="none" stroke="#ffeaa7" stroke-width="8"/>

            <polyline points="0,170 40,200 0,230 40,260 0,290"
                      fill="none" stroke="#00cec9" stroke-width="8"/>

            <polyline points="200,170 160,200 200,230 160,260 200,290"
                      fill="none" stroke="#00cec9" stroke-width="8"/>
        </svg>
        <p>6. Polyline and Polygon</p>
    </div>

    <!-- 7. All Required SVG Elements -->
    <div class="art">
        <svg width="200" height="300">
            <rect width="200" height="300" fill="#81ecec"/>

            <rect x="15" y="15" width="170" height="270"
                  fill="#00cec9"/>

            <polygon points="100,35 175,130 25,130"
                     fill="#fdcb6e"/>

            <circle cx="100" cy="90" r="30" fill="#ff7675"/>
            <circle cx="100" cy="90" r="12" fill="#fff"/>

            <ellipse cx="100" cy="190" rx="65" ry="35"
                     fill="#fab1a0"/>
            <ellipse cx="100" cy="190" rx="30" ry="20"
                     fill="#e17055"/>

            <polyline points="20,250 50,220 80,250 110,220 140,250 170,220 190,250"
                      fill="none" stroke="#6c5ce7" stroke-width="10"/>

            <line x1="20" y1="270" x2="180" y2="270"
                  stroke="#fff" stroke-width="6"/>
            <line x1="100" y1="130" x2="100" y2="155"
                  stroke="#2d3436" stroke-width="5"/>
        </svg>
        <p>7. All SVG Elements</p>
    </div>

</div>

</body>
</html>
